{
    "name": "hradigital/php-datatypes-laravel-doctrine",
    "description": "Doctrine DBAL Types for the hradigital/php-datatypes objects, auto-wired into Laravel.",
    "type": "library",
    "license": "MPL-2.0",
    "keywords": [
        "hradigital",
        "laravel",
        "doctrine",
        "dbal",
        "datatypes",
        "ddd",
        "domain driven design",
        "value objects",
        "custom types"
    ],
    "authors": [
        {
            "name": "Hugo Rafael Azevedo",
            "email": "github@hradigital.com"
        }
    ],
    "homepage": "https://github.com/HRADigital/php-datatypes-laravel-doctrine",
    "support": {
        "issues": "https://github.com/HRADigital/php-datatypes-laravel-doctrine/issues",
        "source": "https://github.com/HRADigital/php-datatypes-laravel-doctrine"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "doctrine/dbal": "^3.8 || ^4.0",
        "hradigital/php-datatypes": "^3.0",
        "illuminate/contracts": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "squizlabs/php_codesniffer": "^3.7 || ^4.0"
    },
    "suggest": {
        "laravel-doctrine/orm": "Doctrine ORM integration for Laravel - this package registers its Types into it automatically."
    },
    "autoload": {
        "psr-4": {
            "HraDigital\\Components\\DatatypesDoctrine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HraDigital\\Tests\\Components\\DatatypesDoctrine\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HraDigital\\Components\\DatatypesDoctrine\\DatatypesDoctrineServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test-code": "./vendor/bin/phpunit --log-junit ci/tests-results.xml",
        "test-cs": "./vendor/bin/phpcs -p --colors --no-cache --report=full",
        "test-static": "./vendor/bin/phpstan analyse --no-progress",
        "test-all": "composer run test-code && composer run test-cs && composer run test-static"
    }
}
